# DeepSeek：密钥只放在 config/.env.school，不要写进源码
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地服务
SCHOOL_HOST=127.0.0.1
SCHOOL_PORT=8765
WECHAT_POLL_SECONDS=5
GROUP_REFRESH_SECONDS=60
DEFAULT_LOOKBACK_DAYS=7
MAX_INITIAL_MESSAGES=800

# 可选：不填时自动发现
WECHAT_DATA_ROOT=
WCDB_TOOL_PATH=
