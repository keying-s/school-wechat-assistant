# DeepSeek：密钥只放在 config/.env.school，不要写进源码
DEEPSEEK_API_KEY=sk-请填写
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 本地服务
SCHOOL_HOST=127.0.0.1
SCHOOL_PORT=8765
WECHAT_POLL_SECONDS=5
GROUP_REFRESH_SECONDS=60
DEFAULT_LOOKBACK_DAYS=7
MAX_INITIAL_MESSAGES=800

# 本地混合检索（中文 ONNX 模型，聊天资料不会上传到向量服务）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=
EMBEDDING_THREADS=8
RAG_CHUNK_CHARS=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=10
RAG_SYNC_SECONDS=15
QA_HISTORY_TURNS=8
QA_SESSION_TTL_HOURS=2

# 可选：不填时自动发现
WECHAT_DATA_ROOT=
WCDB_TOOL_PATH=
